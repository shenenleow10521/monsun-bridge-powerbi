model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","dim_evidence_level","dim_date","dim_district","dim_occupation","dim_occupation_alt","dim_sector","dim_monsoon_window","fct_tourism_exposure","fct_workforce_exposure","fct_sector_seasonality","fct_transition_pathway","fct_skill_evidence","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_evidence_level
ref table dim_date
ref table dim_district
ref table dim_occupation
ref table dim_occupation_alt
ref table dim_sector
ref table dim_monsoon_window
ref table fct_tourism_exposure
ref table fct_workforce_exposure
ref table fct_sector_seasonality
ref table fct_transition_pathway
ref table fct_skill_evidence
ref table _Measures
ref table 'Participation Rate'
ref table 'Training Months'
ref table 'Support Months'
ref table 'Cost Per Worker Month'

ref cultureInfo en-GB

