table Tourism

	column date
		dataType: dateTime
		sourceColumn: date
		summarizeBy: none
		formatString: yyyy-MM-dd

	column quarter
		dataType: string
		sourceColumn: quarter
		summarizeBy: none

	column visitors_million
		dataType: double
		sourceColumn: visitors_million
		summarizeBy: none
		formatString: 0.0

	column expenditure_billion
		dataType: double
		sourceColumn: expenditure_billion
		summarizeBy: none
		formatString: 0.0

	column evidence_level
		dataType: string
		sourceColumn: evidence_level
		summarizeBy: none

	column source_name
		dataType: string
		sourceColumn: source_name
		summarizeBy: none

	column source_url
		dataType: string
		sourceColumn: source_url
		summarizeBy: none
		dataCategory: WebUrl

	partition Tourism = m
		mode: import
		source =
				#table(type table [date = date, quarter = text, visitors_million = number, expenditure_billion = number, evidence_level = text, source_name = text, source_url = text], {
				    {#date(2025, 1, 1), "2025 Q1", 69.7, 29.4, "OBSERVED", "DOSM quarterly release", "https://www.dosm.gov.my/portal-main/release-content/malaysias-domestic-tourism-survey-first-quarter-2025"},
				    {#date(2025, 4, 1), "2025 Q2", 73.8, 29.2, "OBSERVED", "DOSM quarterly release", "https://www.dosm.gov.my/portal-main/release-content/malaysias-domestic-tourism-survey-second-quarter-2025"},
				    {#date(2025, 7, 1), "2025 Q3", 72.6, 29.8, "OBSERVED", "DOSM quarterly release", "https://www.dosm.gov.my/portal-main/release-content/malaysias-domestic-tourism-survey-third-quarter-2025"},
				    {#date(2025, 10, 1), "2025 Q4", 74.0, 32.6, "OBSERVED", "DOSM quarterly release", "https://www.dosm.gov.my/portal-main/release-content/malaysias-domestic-tourism-survey-q42025"}
				})
