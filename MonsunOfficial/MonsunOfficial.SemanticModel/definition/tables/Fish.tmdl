table Fish

	column state
		dataType: string
		sourceColumn: state
		summarizeBy: none

	column date
		dataType: dateTime
		sourceColumn: date
		summarizeBy: none
		formatString: MMM yyyy

	column month
		dataType: int64
		sourceColumn: month
		summarizeBy: none
		formatString: 0

	column landings_mt
		dataType: double
		sourceColumn: landings_mt
		summarizeBy: none
		formatString: #,0

	column source_url
		dataType: string
		sourceColumn: source_url
		summarizeBy: none
		dataCategory: WebUrl

	partition Fish = m
		mode: import
		source =
				#table(type table [state = text, date = date, month = Int64.Type, landings_mt = number, source_url = text], {
