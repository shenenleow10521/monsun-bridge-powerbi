model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	valueFilterBehavior: independent

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Tourism
ref table Monsoon
ref table District
ref table Labour
ref table Income
ref table Fish
ref table Participation
ref table Duration
ref table UnitCost
ref table Metrics

ref relationship LabourDistrict
ref relationship IncomeDistrict
